#include "grids.h"
#include "kernel_class.h"
#include "cuda_constants.h"

__global__ void kInit_gpu(float* kx, float* ky, float* kz, float X0, float Y0, int Zp) 
{
  int id = threadIdx.x + blockIdx.x*blockDim.x;

  if(id<nyc) { 
    ky[id] = (float) id/Y0;
  }
  if(id<nx/2+1) {
    kx[id] = (float) id/X0;
  } else if (id<nx) {
    kx[id] = (float) (id - nx)/X0;
  }
  if(id<(nz/2+1)) {
    kz[id] = (float) id/Zp;
  } else if(id<nz) {
    kz[id] = (float) (id - nz)/Zp;
  }
}

Kernels::Kernels() {}

void Kernels::kInit(int gridsize, int nthreads, int Nx, int Nyc, int Nz, float* kx, float* ky, float* kz, float X0, float Y0, float Zp) {
  cudaMallocHost((void**) &kx_h, sizeof(float)*Nx);
  cudaMallocHost((void**) &ky_h, sizeof(float)*Nyc);
  cudaMallocHost((void**) &kz_h, sizeof(float)*Nz);
  cudaMalloc((void**) &kx, sizeof(float)*Nx);
  cudaMalloc((void**) &ky, sizeof(float)*Nyc);
  cudaMalloc((void**) &kz, sizeof(float)*Nz);
  cudaMemcpyToSymbol(nx,  &Nx, sizeof(int),0,cudaMemcpyHostToDevice);
  cudaMemcpyToSymbol(nz,  &Nz, sizeof(int),0,cudaMemcpyHostToDevice);
  cudaMemcpyToSymbol(nyc, &Nyc, sizeof(int),0,cudaMemcpyHostToDevice);
  cudaDeviceSynchronize();
  kInit_gpu<<<gridsize, nthreads>>>(kx, ky, kz, X0, Y0, Zp);

  CP_TO_CPU(kx_h, kx, sizeof(float)*Nx);
  CP_TO_CPU(ky_h, ky, sizeof(float)*Nyc);
  CP_TO_CPU(kz_h, kz, sizeof(float)*Nz);
}

