#define CATCH_CONFIG_MAIN
#include "catch.hpp"
#include <string>

// some example function I found online that returns strings based on what the input number is divisible by. Easy to test different catch2 functions with in test.cpp
std::string fizzbuzz(int const number) {
  if (number != 0) {
    auto m3 = number % 3;
    auto m5 = number % 5;
    if (!m5 && !m3) { return "fizzbuzz"; }
    else if (!m5) { return "buzz"; }
    else if (!m3) { return "fizz"; }
  }
  return std::to_string(number);
}


// Set of different catch2 assertion macros
TEST_CASE("Test with zero", "[basic]") {
  REQUIRE(fizzbuzz(0) == "0");
  /* Notes:
     "Test with zero" is just the name of the test case
     [basic] is a tag for the test case. There should be a way to only run tests for cases with particular tags
     With "REQUIRE" keyword, test will fail if condition is not satisfied, and any further assertions won't be tested
  */
}

TEST_CASE("Check with zero", "[basic]") {
  CHECK(fizzbuzz(0) == "1"); // "CHECK" is almost the same as "REQUIRE", but other assertions within the TEST_CASE are still performed 
  REQUIRE(fizzbuzz(0) == "0");
}

TEST_CASE("Test positives", "[positives]") {
  SECTION("Test numbers up to 10") {
    REQUIRE(fizzbuzz(1) == "1"); 
    REQUIRE(fizzbuzz(2) == "2");
    REQUIRE(fizzbuzz(3) == "fizz");
    REQUIRE(fizzbuzz(4) == "4");
    REQUIRE(fizzbuzz(5) == "buzz");
    REQUIRE(fizzbuzz(6) == "fizz");
    REQUIRE(fizzbuzz(7) == "7");
    REQUIRE(fizzbuzz(8) == "8");
    REQUIRE(fizzbuzz(9) == "fizz");
    REQUIRE(fizzbuzz(10) == "buzz");
  }

  SECTION("Test all multiples of 3 only up to 100") {
    for (int i = 3; i <= 100; i+=3) {
      if (i % 5) REQUIRE(fizzbuzz(i) == "fizz");
    }
  }

  SECTION("Test all multiples of 5 only up to 100") {
    for (int i = 5; i <= 100; i += 5) {
      if (i % 3) REQUIRE(fizzbuzz(i) == "buzz");
    }
  }
  
  SECTION("Test all multiples of 3 and 5 up to 100") {
    for (int i = 15; i <= 100; i += 15) {
      REQUIRE(fizzbuzz(i) == "fizzbuzz");
    }
  }
}

// can also compare floating points to within a desired tolerance
TEST_CASE("Floating point compare", "[basic]") {
  REQUIRE( 2.100002 == Approx(2.1) ); // This should pass using default Approx tolerances
  Approx target = Approx(100).epsilon(0.01); // can define approximations with arbitrary tolerances as well
  CHECK( 100.0 == target); // must pass
  CHECK( 200.0 == target); // must fail
  CHECK( 100.5 == target); // pass with 1% tolerance
  Approx approx_margin = Approx(100).margin(5);
  CHECK( 100.0 == approx_margin);
}
