#!/bin/bash
#SBATCH --nodes=NODE_VAL
#SBATCH --ntasks-per-node=TASKS_PER_NODE
#SBATCH --gpus-per-task=GPUS_PER_TASK
#SBATCH --time=ZZHRS:ZZMINS:00
#SBATCH -J filename_val
#SBATCH --mail-type=ALL
#SBATCH --mail-user=jfparisi@princeton.edu
#SBATCH --reservation=test

#source ~/.bash_profile
module purge
module load cudatoolkit/11.0
module load openmpi/cuda-11.0/gcc/4.0.4/64
module load netcdf/gcc/hdf5-1.10.6/openmpi-4.0.4/4.7.3
module load hdf5/gcc/openmpi-4.0.4/1.10.6
module load gsl/1.15
export GK_SYSTEM=traverse
export MAKEFLAGS=-IMakefiles

srun /scratch/gpfs/jfparisi/ntft_aug4/gx filename_val.in > filename_val.out
